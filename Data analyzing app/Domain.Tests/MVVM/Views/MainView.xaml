<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Domain.Tests.MVVM.ViewModels"
    x:Class="Domain.Tests.MVVM.Views.MainView"
>
    <ScrollView>
        <VerticalStackLayout>
            <Label StyleClass="TitleLabel"/>
            <Button
                Command="{Binding RefreshCommand}"
                StyleClass="RefreshButton"
            />

            <CollectionView
                ItemsSource="{Binding Machines}"
                StyleClass="MainCollectionView"
            >
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="25"
                        Orientation="Vertical"
                        Span="2"
                        VerticalItemSpacing="25"
                    />
                </CollectionView.ItemsLayout>
            
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <RoundRectangle StyleClass="BackgroundRoundRectangle"/>
                            <FlexLayout StyleClass="MachineNameFlexLayout">
                                <Label 
                                    StyleClass="MachineNameLabel"
                                    Text="{Binding Name}"
                                />
                                <Button
                                    Command="{Binding Source={RelativeSource AncestorType=local:MainViewModel}, Path=ShowDetailsCommand}"
                                    CommandParameter="{Binding .}"
                                    StyleClass="MachineDetailsButton"
                                />
                            </FlexLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            
                <CollectionView.EmptyView>
                    <Label StyleClass="EmptyCollectionViewLabel"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>