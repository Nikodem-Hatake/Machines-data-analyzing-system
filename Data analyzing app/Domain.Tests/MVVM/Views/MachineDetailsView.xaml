<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Domain.Tests.MVVM.Views.MachineDetailsView"
>
    <Grid RowDefinitions=".1*, .2*, .1*, .6*">
        <Label
            StyleClass="TitleLabel"
            Text="{Binding Machine.Name}"
        />
        <Button
            Command="{Binding RefreshCommand}"
            StyleClass="RefreshButton"
        />

        <Grid 
            Grid.Row="1"
            Margin="25"
        >
            <RoundRectangle StyleClass="BackgroundRoundRectangle"/>
            <FlexLayout StyleClass="MachineDetailsFlexLayout">
                <Label
                    StyleClass="MachineDetailsLabel"
                    Text="{Binding MachineDetails.AverageTemperature, 
                    StringFormat='Average temperature: {0:F2}'}"
                />
                <Label
                    StyleClass="MachineDetailsLabel"
                    Text="{Binding MachineDetails.AverageTimeProcessingRecources, 
                    StringFormat='Average time processing resource: {0:F2}'}"
                />
                <Label
                    StyleClass="MachineDetailsLabel"
                    Text="{Binding MachineDetails.LastUpdateDateTime, 
                    StringFormat='Last update date: {0}'}"
                />
                <Label
                    StyleClass="MachineDetailsLabel"
                    Text="{Binding MachineDetails.TotalResourcesProcessed, 
                    StringFormat='Total resources processed: {0}'}"
                />
            </FlexLayout>
        </Grid>

        <FlexLayout
            Grid.Row="2"
            JustifyContent="SpaceEvenly"
        >
            <Button
                Command="{Binding PreviousPaginationMachineDetailCommand}"
                StyleClass="PaginationButton"
                Text="Previous"
            />
            <Button
                Command="{Binding NextPaginationMachineDetailCommand}"
                StyleClass="PaginationButton"
                Text="Next"
            />
        </FlexLayout>

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding MachineDatas}"
            StyleClass="MainCollectionView"
        >
            <CollectionView.Header>
                <Grid>
                    <RoundRectangle StyleClass="BackgroundRoundRectangle"/>
                    <Grid ColumnDefinitions=".1*, .2*, .2*, .2*, .3*">
                        <Border StyleClass="TableCellBorder">
                            <Label
                                StyleClass="MachineDetailsLabel"
                                Text="Id"
                            />
                        </Border>
                        <Border 
                            Grid.Column="1"
                            StyleClass="TableCellBorder"
                        >
                            <Label
                                StyleClass="MachineDetailsLabel"
                                Text="Processed resources"
                            />
                        </Border>
                        <Border 
                            Grid.Column="2"
                            StyleClass="TableCellBorder"
                        >
                            <Label
                                StyleClass="MachineDetailsLabel"
                                Text="Seconds to process"
                            />
                        </Border>
                        <Border 
                            Grid.Column="3"
                            StyleClass="TableCellBorder"
                        >
                            <Label
                                StyleClass="MachineDetailsLabel"
                                Text="Temperature"
                            />
                        </Border>
                        <Border 
                            Grid.Column="4"
                            StyleClass="TableCellBorder"
                        >
                            <Label
                                StyleClass="MachineDetailsLabel"
                                Text="Update data"
                            />
                        </Border>
                    </Grid>
                </Grid>
            </CollectionView.Header>
            
            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StyleClass="TableCellBorder">
                        <Grid>
                            <RoundRectangle StyleClass="BackgroundRoundRectangle"/>
                            <Grid ColumnDefinitions=".1*, .2*, .2*, .2*, .3*">
                                <Border StyleClass="TableCellBorder">
                                    <Label
                                        StyleClass="MachineDetailsLabel"
                                        Text="{Binding Id}"
                                    />
                                </Border>
                                <Border 
                                    Grid.Column="1"
                                    StyleClass="TableCellBorder"
                                >
                                    <Label
                                        StyleClass="MachineDetailsLabel"
                                        Text="{Binding NumberOfProcessedResourcesSinceGettingData}"
                                    />
                                </Border>
                                <Border 
                                    Grid.Column="2"
                                    StyleClass="TableCellBorder"
                                >
                                    <Label
                                        StyleClass="MachineDetailsLabel"
                                        Text="{Binding SecondsInWhichResourcesWasProcessed, StringFormat='{0:F2}'}"
                                    />
                                </Border>
                                <Border 
                                    Grid.Column="3"
                                    StyleClass="TableCellBorder"
                                >
                                    <Label
                                        StyleClass="MachineDetailsLabel"
                                        Text="{Binding Temperature, StringFormat='{0:F2}'}"
                                    />
                                </Border>
                                <Border 
                                    Grid.Column="4"
                                    StyleClass="TableCellBorder"
                                >
                                    <Label
                                        StyleClass="MachineDetailsLabel"
                                        Text="{Binding UpdateDataDate}"
                                    />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>