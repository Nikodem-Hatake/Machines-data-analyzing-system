@inject NavigationManager navigationManager

<MudItem
    xs="6"
    md="3"
    lg="2"
>
    <MudCard 
        style="height:100%"
    >
        <MudCardContent>
            <MudText Align="Align.Center" Typo="Typo.h6">@Machine.Name</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton @onclick="NavigateToDetailsPage" Variant="Variant.Filled">Details</MudButton>
        </MudCardActions>
    </MudCard>
</MudItem>