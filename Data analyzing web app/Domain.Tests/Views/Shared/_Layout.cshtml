<!DOCTYPE html>
<html>
<head>
    <link href="~/style.css" rel="stylesheet" type="text/css" />
    <meta charset="utf-8"/>
    <title>@ViewBag.Title</title>
</head>
<body>
    <header>
        <h1>@ViewBag.Title</h1>
    </header>
    @RenderBody()
    <footer>
        <h2>Machines data analyzing system @@@DateTime.Now.Year</h2>
    </footer>
    @await RenderSectionAsync("script", false)
</body>
</html>