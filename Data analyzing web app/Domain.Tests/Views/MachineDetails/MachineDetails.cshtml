@model MachineDetailsViewModel
<!DOCTYPE html>
<html>
<head>
    <link href="~/style.css" rel="stylesheet" type="text/css" />
    <meta charset="utf-8" />
    <title>Machine details</title>
</head>
<body>
    <header>
        <h1>Machine details</h1>
        <form action="/" method="get" class="m1 backToMachinesForm">
            <button class="machineDetailsButton">Back to machines</button>
        </form>
    </header>
    <main class="machineDetailsMain">
        @{
            Machine? machine = await Model.GetMachineAsync();
            if(machine == null)
            {
                <h2>Couldn't get machine details</h2>
            }
            else
            {
                <div class="machineDiv">
                    <h2>@machine.Name</h2>
                    <form action="/machineDetails/@machine.Id" method="post">
                        <label for="startDateInput">
                            Start date: 
                            <input type="datetime-local" name="startDate" id="startDateInput" value="@Model.StartDate" required/>
                        </label>
                        <label for="howManyDatesForward">
                            How many aggregated datas forward?: 
                            <input type="number" step="1" min="1" max="10" name="howManyDatesForward" value="@Model.HowManyDatasForward" id="howManyDatesForward" required />
                        </label>
                        <button class="machineDetailsButton">See aggregated datas</button>
                    </form>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th rowspan="2">Start date</th>
                            <th rowspan="2">Avg seconds to process resource</th>
                            <th colspan="3">Temperature</th>
                            <th rowspan="2">Sum of processed resources</th>
                        </tr>
                        <tr>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Avg</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.IsFormSendedCorrectly)
                        {
                            foreach(AggregatedMachineDatas aggregatedMachineData
                                in await Model.GetAggregatedMachineDatasAsync())
                            {
                                <tr>
                                    <td>@aggregatedMachineData.StartDate</td>
                                    <td>@aggregatedMachineData.AverageSecondsInWhichResourceIsProcessed.ToString("N2")</td>
                                    <td>@aggregatedMachineData.MinimumTemperature.ToString("N2")</td>
                                    <td>@aggregatedMachineData.MaximumTemperature.ToString("N2")</td>
                                    <td>@aggregatedMachineData.AverageTemperature.ToString("N2")</td>
                                    <td>@aggregatedMachineData.TotalNumberOfProcessedResources</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        }
    </main>
    <footer>
        <h2>Machines data analyzing system @@@DateTime.Now.Year</h2>
    </footer>
</body>
</html>