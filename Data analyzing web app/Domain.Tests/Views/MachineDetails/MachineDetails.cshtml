@model MachineDetailsViewModel
@{
    ViewBag.Title = "Machine details";
}
<main class="machineDetailsMain">
    <form action="/" method="get" class="m1 backToMachinesForm">
        <button class="topRightButton">Back to machines</button>
    </form>
    @await Html.PartialAsync("_MachineDetailsPartialView")
    <table>
        <thead>
            <tr>
                <th rowspan="2">Start date</th>
                <th rowspan="2">Avg seconds to process resource</th>
                <th colspan="3">Temperature</th>
                <th rowspan="2">Sum of processed resources</th>
            </tr>
            <tr>
                <th>Min</th>
                <th>Max</th>
                <th>Avg</th>
            </tr>
        </thead>
        <tbody id="AggregatedMachineDatas"></tbody>
    </table>
</main>
@section script
{
    <script src="~/Scripts/MachineDetailsViewScript.js"></script>
}